DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Routine chat defaults to non-thinking; structured analysis always disables it.
DEEPSEEK_THINKING=disabled
DATA_DIR=data
# Set true to require password sessions for group APIs as well as personal space.
AUTH_REQUIRED=false

# 高德地图 MCP（距离、天气、附近急诊）。只写在本地 .env，不要提交到仓库：
# AMAP_MCP_URL=https://mcp.amap.com/mcp?key=你的高德Key
AMAP_MCP_URL=

# Local hospital simulator. This is served by the main FastAPI process.
HOSPITAL_BASE=http://127.0.0.1:8000/hospital/

# ---- 家人帮演示 ----
# 首次启动（群里没有消息）自动写入演示家庭数据；设为 false 关闭
DEMO_AUTOSEED=true
# 浏览器代办：默认弹出可见窗口并放慢每一步，方便评委看清；设为 1 改为后台运行
HOSPITAL_HEADLESS=
# 每一步点击前的停顿（毫秒）与提交后在结果页停留时间
HOSPITAL_STEP_PAUSE=650
HOSPITAL_RESULT_HOLD=2500
